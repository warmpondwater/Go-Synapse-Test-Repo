  },
  "verification_assertions": {
    "deterministic_hash_algorithm": "SHA-256(canonical_nodes_asc + canonical_edges_asc)",
    "golden_sha256_digest": "b6d6694cccee5348f5707004e52f0b33b593e8e89eef27b4d8a9219c4665964d",
    "expected_reconciled_nodes": 1660,
    "expected_reconciled_edges": 330,
    "expected_node_reconciliation_rate": "100.00%",
    "expected_edge_reconciliation_rate": "100.00%",
    "dead_code_quarantine_assertion": "Nodes with 0 in-degree and (DEAD CODE) badge must be quarantined in database verification pass",
    "taint_continuity_assertion": "Every language must form an uninterrupted directed path from SOURCE -> SANITIZER -> SINK",
    "zero_dangling_links_assertion": "Reconciliation pass must prune or verify 0 dangling edges pointing to non-existent nodes"
  }
}
