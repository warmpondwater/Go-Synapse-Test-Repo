{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Go-Synapse-Test-Repo-Verification-Suite",
  "version": "1.0.0",
  "description": "Deterministic multi-language testbed and golden verification manifest for Go-Synapse Tree-sitter and LSP engine.",
  "disclaimer": "All code snippets and scenarios in this testbed are for educational, testing, and benchmark demonstration purposes only. They contain deliberate flaws and must not be used in production or as definitive solutions.",
  "target_directory": "/Users/max/GitHub/Go-Synapse-Test-Repo",
  "languages_covered": [
    "Go",
    "TypeScript",
    "JavaScript",
    "Python",
    "Rust",
    "C",
    "C++",
    "C#",
    "Java",
    "PHP",
    "Ruby"
  ],
  "edge_typology_coverage": {
    "calls": "Invoking functions or class/struct methods across files and local scopes",
    "returns": "Returning values, variables, or struct/object instances from functions",
    "reads": "Reading struct fields, object properties, or global variables",
    "writes": "Mutating fields, variables, or assigning to memory locations",
    "instantiates": "Creating struct pointers, new class instances, or object literals",
    "references": "Declaring struct/interface member types or parameters referencing other symbols",
    "implements": "Classes or structs implementing interfaces or traits",
    "contains": "Hierarchical container edges (package -> file -> class/struct/function)"
  },
  "taint_security_patterns": {
    "source_marker": "// (SOURCE) or # (SOURCE)",
    "sanitizer_marker": "// (SANITIZER) or # (SANITIZER) or // (SHIELD)",
    "sink_marker": "// (SINK) or # (SINK)",
    "dead_code_marker": "// (DEAD CODE) or # (DEAD CODE)",
    "secret_marker": "// (SECRET)",
    "opaque_boundary_marker": "unsafe.Pointer or reflect.Value"
  },
  "test_suites": {
    "go": {
      "path": "go_src",
      "files": ["main.go", "dataflow.go", "dead_code.go", "generated_proto.go", "auth/token.go"],
      "expected_nodes": ["TokenProcessor", "SecurityPipeline", "SecretAuthorizer", "VerifyAuthToken", "GetUserInput", "SanitizeInput", "ExecuteDatabaseQuery", "RunDataFlow", "InspectMemoryHeader", "MasterAPIKey", "TotallyUnusedGlobalVariable", "ForgottenFunctionThatDoesNothing", "AbandonedStruct"],
      "expected_taint_path": ["GetUserInput", "SanitizeInput", "ExecuteDatabaseQuery"],
      "lsp_server": "gopls"
    },
    "typescript": {
      "path": "ts_src",
      "files": ["test.ts", "types.ts"],
      "expected_nodes": ["UserProfile", "IUserManager", "UserManager", "AbandonedTsHelper", "getIncomingRegistrationPayload", "sanitizeProfile", "persistUserToDatabase", "registerUser", "getUserCount"],
      "expected_taint_path": ["getIncomingRegistrationPayload", "sanitizeProfile", "persistUserToDatabase"],
      "lsp_server": "typescript-language-server"
    },
    "javascript": {
